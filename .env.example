# ==============================================================================
# Gatherwise Environment Configuration Template
# Copy this file to .env.local to configure connected cloud mode or live AI models.
# Note: If no keys are provided, Gatherwise automatically runs in full Demo Mode
# with persistent local browser storage and an intelligent offline AI planner.
# ==============================================================================

# Supabase Postgres & Auth (Optional - for connected multi-device cloud storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# AI Provider API Keys (Optional - choose one if you want live cloud LLM calls)
# Supports OpenAI, Anthropic, or Google Gemini via Vercel AI SDK
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy...
# AI_MODEL=gpt-4o-mini # or claude-3-5-sonnet-20241022, gemini-1.5-flash
